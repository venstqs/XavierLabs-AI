# =====================================================================
# XavierLabs AI - Environment Configuration
# =====================================================================
# XavierLabs AI supports ANY LLM provider via LiteLLM.
# You only need to configure ONE provider (or use 100% free local Ollama).

# ---------------------------------------------------------------------
# Option 1: OpenRouter (Universal access to DeepSeek, Claude, Llama, etc.)
# ---------------------------------------------------------------------
OPENROUTER_API_KEY=
# Example models:
#   openrouter/deepseek/deepseek-r1
#   openrouter/deepseek/deepseek-chat
#   openrouter/anthropic/claude-3.5-sonnet

# ---------------------------------------------------------------------
# Option 2: DeepSeek Direct API
# ---------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Example models:
#   deepseek/deepseek-chat
#   deepseek/deepseek-reasoner

# ---------------------------------------------------------------------
# Option 3: 100% Free Local Offline Inference (Ollama)
# (Zero API keys needed! Just install Ollama and run `ollama run deepseek-r1`)
# ---------------------------------------------------------------------
# OLLAMA_API_BASE=http://localhost:11434
# DEFAULT_MODEL=ollama/deepseek-r1

# ---------------------------------------------------------------------
# Option 4: Custom / Local OpenAI-Compatible (LM Studio, OpenCode, vLLM)
# ---------------------------------------------------------------------
# OPENAI_API_BASE=http://localhost:1234/v1
# DEFAULT_MODEL=openai/default

# ---------------------------------------------------------------------
# Option 5: Ultra-fast Groq
# ---------------------------------------------------------------------
GROQ_API_KEY=
# Example models:
#   groq/llama-3.3-70b-versatile
#   groq/deepseek-r1-distill-llama-70b

# ---------------------------------------------------------------------
# Option 6: Google Gemini (Free tier available)
# ---------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# Option 7: OpenAI & Anthropic
# ---------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =====================================================================
# Optional: Granular Per-Agent Model Routing
# Set to "auto" to automatically pick the best available configured key,
# or specify exact model strings for each persona.
# =====================================================================
IDEATOR_MODEL=auto
REVIEWER_MODEL=auto
CODER_MODEL=auto
SYNTHESIZER_MODEL=auto

# =====================================================================
# Execution Sandbox Settings
# "auto" (Docker if running, otherwise isolated local subprocess)
# =====================================================================
SANDBOX_MODE=auto
EXECUTION_TIMEOUT=180
MAX_DEBUG_RETRIES=3

# Optional: Academic search keys (ArXiv is free without key)
TAVILY_API_KEY=
