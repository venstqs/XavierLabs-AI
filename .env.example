# XavierLabs AI Configuration

# LLM Providers (Configure at least one, or use local Ollama)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Hybrid Compute Model Routing (LiteLLM model identifiers)
IDEATOR_MODEL=gemini/gemini-2.5-flash
REVIEWER_MODEL=gemini/gemini-2.5-flash
CODER_MODEL=gemini/gemini-2.5-flash
SYNTHESIZER_MODEL=gemini/gemini-2.5-flash

# For local models via Ollama:
# REVIEWER_MODEL=ollama/deepseek-r1
# OLLAMA_API_BASE=http://localhost:11434

# Execution Sandbox: "auto" (Docker if available, else local isolated subprocess), "docker", or "local"
SANDBOX_MODE=auto
EXECUTION_TIMEOUT=180
MAX_DEBUG_RETRIES=3

# Optional academic/search keys
TAVILY_API_KEY=
