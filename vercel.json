{
  "version": 2,
  "builds": [
    {
      "src": "docs/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/docs/assets/$1"
    },
    {
      "src": "/style.css",
      "dest": "/docs/style.css"
    },
    {
      "src": "/app.js",
      "dest": "/docs/app.js"
    },
    {
      "src": "/(.*)",
      "dest": "/docs/index.html"
    }
  ]
}
